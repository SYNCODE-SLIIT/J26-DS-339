# Local recordings, downloaded tools and learned weights.
/datasets/
/models_and_tools/
/selected_model/

# Archived experiment runs (about 6 GB of WAV/NPZ outputs, user recordings, paths too long for Windows).
# The reports that describe them live in archive/documentation and deliverables/.
/archive/experiments/
/archive/**/*.whl
/archive/**/*.npz
/archive/**/*.wav

# Generated runs, rendered audio, charts, reports and notebook runtimes.
# Keep the scripts and instructions needed to rebuild the reading views.
/results/*
!/results/README.md
!/results/*.ps1
!/results/build_views.py

# Executed HTML and embedded notebook outputs are kept locally, not in Git.
/notebooks/*.html
**/.ipynb_checkpoints/
__pycache__/
*.py[cod]

# Local scratch/compiler caches and editable package metadata.
/tmp/
source/*.egg-info/
